# Aftermath — codified operational targets (single source of truth)
#
# Every target's documentation lives in its
#   ## category :: target :: usage-args :: description
# line (immediately above the rule). From those lines `make help` renders the
# console help, `make agents-doc` renders the AGENTS.md block, `make
# docs-sync` writes it into AGENTS.md, and `make docs-check` FAILS if
# AGENTS.md is stale (wired into commit-unit and the pre-commit hook — no
# new target can ship without its documentation landing in AGENTS.md first).
#
# Each target encodes the LEARNED CORRECT FORM, not a shorthand: the
# batch-mode ssh flags, COPYFILE_DISABLE tar-piping, probe timeouts +
# evidence teeing, controls-before-attacks gating, ASan container
# incantations, the private-remote check, CVSS 4.0 mandatory metrics, and
# the child-hang triage procedure. If a target's flags look fussy, they
# were earned the hard way.

VM_HOST  ?= 10.20.0.18
VM_PORT  ?= 2222
VM_USER  ?= aftermath
VM_SSH   := ssh -o BatchMode=yes -p $(VM_PORT) $(VM_USER)@$(VM_HOST)
VM_SCP   := scp -o BatchMode=yes -P $(VM_PORT)
BATTERY   ?= findings/minrepro/rsync_hunt/battery.rb

AGENTS_MD := AGENTS.md

.DEFAULT_GOAL := help

# ── documentation plumbing ──────────────────────────────────────────────────

## meta :: help :: (none) :: list every documented target, grouped by category
.PHONY: help
help:
	@echo "Aftermath operational targets (docs live in the Makefile '## ' lines; sync AGENTS.md with: make docs-sync):"
	@echo
	@grep '^## ' $(firstword $(MAKEFILE_LIST)) | sed 's/^## //' | awk -F' :: ' '{ \
		if ($$1 != cat) { cat = $$1; print "\n" cat ":" } \
		printf "  %-34s %s\n", $$2, $$3 }'

## meta :: agents-doc :: (none) :: print the AGENTS.md targets block (generated form)
.PHONY: agents-doc
agents-doc:
	@echo "<!-- BEGIN MAKE-TARGETS (generated by: make docs-sync — do not hand-edit) -->"
	@grep '^## ' $(firstword $(MAKEFILE_LIST)) | sed 's/^## //' | awk -F' :: ' \
		'BEGIN { print "| Target | Usage | What it does (learned-correct form) |"; print "|---|---|---|" } \
		{ split($$2, w, " "); u = ""; for (i = 2; w[i] != ""; i++) u = u (u ? " " : "") w[i]; \
		  if (u == "") u = "(no arguments)"; \
		  desc = ($$3 == "(none)") ? $$4 : $$3 " — " $$4; \
		  printf "| `%s` | `%s` | %s |\n", w[1], u, desc }'
	@echo "Regenerate with \`make docs-sync\` after adding any target (the pre-commit hook enforces it)."
	@echo "<!-- END MAKE-TARGETS -->"

## meta :: docs-sync :: (none) :: write the generated targets block into AGENTS.md (single source: this Makefile)
.PHONY: docs-sync
docs-sync:
	@$(MAKE) --no-print-directory agents-doc > /tmp/make-targets-block.md
	@awk -v f="/tmp/make-targets-block.md" \
		-v begin="<!-- BEGIN MAKE-TARGETS" -v end="<!-- END MAKE-TARGETS -->" \
		'BEGIN { inb = 0 } \
		 index($$0, begin) == 1 { while ((getline l < f) > 0) print l; inb = 1; next } \
		 index($$0, end) == 1 { if (inb) { inb = 0; next } else { print; next } } \
		 !inb { print }' $(AGENTS_MD) > /tmp/agents-new.md \
		&& mv /tmp/agents-new.md $(AGENTS_MD) \
		&& echo "AGENTS.md targets block synced from the Makefile."

## meta :: docs-check :: (none) :: drift gate: FAIL if AGENTS.md block differs from the Makefile doc lines
.PHONY: docs-check
docs-check:
	@$(MAKE) --no-print-directory agents-doc > /tmp/make-targets-expected.md
	@sed -n '/<!-- BEGIN MAKE-TARGETS/,/<!-- END MAKE-TARGETS -->/p' $(AGENTS_MD) > /tmp/make-targets-actual.md
	@if diff -q /tmp/make-targets-expected.md /tmp/make-targets-actual.md >/dev/null; then \
		echo "docs-check: AGENTS.md targets block is in sync with the Makefile."; \
	else \
		echo "docs-check: AGENTS.md targets block is STALE vs the Makefile doc lines."; \
		echo "  -> run: make docs-sync   (then commit; the pre-commit hook enforces this)"; \
		diff /tmp/make-targets-expected.md /tmp/make-targets-actual.md | head -10; exit 1; fi

# ── VM transport ────────────────────────────────────────────────────────────

## VM transport :: vm-exec CMD='...' :: run a command on the lab VM :: batch-mode keyed ssh (the prefix adhoc lines keep dropping)
.PHONY: vm-exec
vm-exec:
	@test -n "$(CMD)" || (echo "usage: make vm-exec CMD='docker ps'" && exit 2)
	$(VM_SSH) '$(CMD)'

## VM transport :: vm-stage-dir DIR=path [BASE=.] :: tar-pipe a directory to the VM :: the private channel — COPYFILE_DISABLE set, no outbound from the VM, lands under ~/
.PHONY: vm-stage-dir
vm-stage-dir:
	@test -n "$(DIR)" || (echo "usage: make vm-stage-dir DIR=findings/minrepro/x/rig BASE=findings/minrepro/x" && exit 2)
	COPYFILE_DISABLE=1 tar -cf - -C $(BASE) $(DIR) | $(VM_SSH) 'tar -xf - -C ~ && echo "staged: ~/$$(basename $(DIR))"'

## VM transport :: vm-script SCRIPT=path :: stage a local script file and run it on the VM :: kills the quoting-hell class — any VM operation more complex than a single flat command lives in a script file, never in a vm-exec CMD= one-liner (nested quotes broke vm-exec three times in one debug session)
.PHONY: vm-script
vm-script:
	@test -n "$(SCRIPT)" || (echo "usage: make vm-script SCRIPT=/tmp/rd2.sh" && exit 2)
	$(VM_SCP) "$(SCRIPT)" "$(VM_USER)@$(VM_HOST):/tmp/$(notdir $(SCRIPT))"
	$(VM_SSH) 'sh /tmp/$(notdir $(SCRIPT))'

## VM transport :: vm-stage-file FILE=path :: scp one file to VM:/tmp/ :: keyed scp for probes/batteries
.PHONY: vm-stage-file
vm-stage-file:
	@test -n "$(FILE)" || (echo "usage: make vm-stage-file FILE=/local/path.rb" && exit 2)
	$(VM_SCP) "$(FILE)" $(VM_USER)@$(VM_HOST):/tmp/

## VM transport :: vm-pull-file FILE=vm-path DEST=local-dir :: pull a file back from the VM :: the evidence-return leg of the private channel
.PHONY: vm-pull-file
vm-pull-file:
	@test -n "$(FILE)" && test -n "$(DEST)" || (echo "usage: make vm-pull-file FILE=/tmp/x.jsonl DEST=evidence/" && exit 2)
	$(VM_SCP) "$(VM_USER)@$(VM_HOST):$(FILE)" "$(DEST)"

## VM transport :: vm-ports :: docker ps state + port map of all rigs :: run before every fire
.PHONY: vm-ports
vm-ports:
	$(VM_SSH) 'docker ps --format "{{.Names}} {{.Ports}} {{.Status}}"'

## VM transport :: vm-recorder PORT=nnnn :: verify the wire recorder is listening :: fails loudly if absent — re-run the rig vm_up.sh before firing through it
.PHONY: vm-recorder
vm-recorder:
	@test -n "$(PORT)" || (echo "usage: make vm-recorder PORT=12627" && exit 2)
	$(VM_SSH) 'ss -ltn | grep $(PORT) || (echo "recorder NOT listening on $(PORT) — re-run the rig vm_up.sh first" && exit 1)'

# ── Fire & evidence ─────────────────────────────────────────────────────────

## Fire & evidence :: probe-fire SCRIPT= PORT= MODE= EVIDENCE=path :: timeout-wrapped probe fire, teed to evidence :: EVIDENCE is mandatory — conversation output is not an evidence bundle
.PHONY: probe-fire
probe-fire:
	@test -n "$(SCRIPT)" && test -n "$(PORT)" && test -n "$(EVIDENCE)" || (echo "usage: make probe-fire SCRIPT=/tmp/probe.rb PORT=12626 MODE=trigger-delayed EVIDENCE=evidence/run1.txt" && exit 2)
	mkdir -p $$(dirname $(EVIDENCE))
	$(VM_SSH) 'timeout $(if $(TIMEOUT),$(TIMEOUT),90) ruby $(SCRIPT) 127.0.0.1 $(PORT) $(if $(MODE),$(MODE),trigger)' | tee $(EVIDENCE)

## Fire & evidence :: battery-selftest DIR=path [VM_DIR=/tmp] :: run a battery selftest :: the verdict gate — a non-PASS selftest blocks any live fire (controls apply to the harness too)
.PHONY: battery-selftest
battery-selftest:
	@test -n "$(DIR)" || (echo "usage: make battery-selftest DIR=findings/minrepro/rsync_hunt" && exit 2)
	$(VM_SSH) 'cd $(if $(VM_DIR),$(VM_DIR),/tmp) && HUNT5_HOLD=3 timeout 300 ruby $(DIR)/battery.rb selftest 2>&1 | tail -4'

## Fire & evidence :: battery-live DIR=path PORT=n [HUNT5_ONLY=...] [OUT=] :: live battery fire :: standard hold/idle/probe-cap envs; canary cadence is the battery's job
.PHONY: battery-live
battery-live:
	@test -n "$(DIR)" && test -n "$(PORT)" || (echo "usage: make battery-live DIR=findings/minrepro/rsync_hunt PORT=61621 [HUNT5_ONLY='b_sums']" && exit 2)
	$(VM_SSH) 'cd $(if $(VM_DIR),$(VM_DIR),/tmp) && HUNT5_HOST=127.0.0.1 HUNT5_HOLD=15 HUNT5_IDLE=2 HUNT5_PROBE_CAP=150 $(if $(HUNT5_ONLY),HUNT5_ONLY=$(HUNT5_ONLY),) HUNT5_OUT=$(if $(OUT),$(OUT),/tmp/hunt5-live.jsonl) timeout 1500 ruby $(DIR)/battery.rb live'

## Fire & evidence :: controls-run SCRIPT=vm-path :: run a rig's controls :: controls before attacks, every suite; a failed control means suspect the RIG first
.PHONY: controls-run
controls-run:
	@test -n "$(SCRIPT)" || (echo "usage: make controls-run SCRIPT=/tmp/vm_controls.sh" && exit 2)
	$(VM_SSH) 'bash $(SCRIPT)'

## Fire & evidence :: evidence-logs CONTAINER=c OUT=path :: pull a container's full logs to an evidence file :: stdout+stderr (the old dropped-stderr lesson)
.PHONY: evidence-logs
evidence-logs:
	@test -n "$(CONTAINER)" && test -n "$(OUT)" || (echo "usage: make evidence-logs CONTAINER=exim-era-tls OUT=evidence/logs.txt" && exit 2)
	mkdir -p $$(dirname $(OUT))
	$(VM_SSH) 'docker logs $(CONTAINER) 2>&1' > $(OUT)
	@echo "pulled to $(OUT)"

## Fire & evidence :: asan-baseline CONTAINER=c [LOGDIR=...] :: count/uniq ASan reports BEFORE firing :: the noise-baseline rule — a probe is ASan-positive only for signatures NOT in this baseline
.PHONY: asan-baseline
asan-baseline:
	@test -n "$(CONTAINER)" || (echo "usage: make asan-baseline CONTAINER=exim-era-asan [LOGDIR=/var/spool/exim/log]" && exit 2)
	$(VM_SSH) 'docker exec $(CONTAINER) sh -c "grep -h \"ERROR: AddressSanitizer\" $(if $(LOGDIR),$(LOGDIR),/tmp)/asan.* 2>/dev/null | sort | uniq -c; ls $(if $(LOGDIR),$(LOGDIR),/tmp)/asan.* 2>/dev/null | wc -l"'

## Fire & evidence :: asan-report-newest CONTAINER=c SIGNATURE=s OUT=path :: extract the newest report matching a signature :: no-match is an honest negative (evidenced absence), not a failure
.PHONY: asan-report-newest
asan-report-newest:
	@test -n "$(CONTAINER)" && test -n "$(SIGNATURE)" && test -n "$(OUT)" || (echo "usage: make asan-report-newest CONTAINER=exim-era-asan SIGNATURE=heap-use-after-free OUT=evidence/report.txt" && exit 2)
	mkdir -p $$(dirname $(OUT))
	$(VM_SSH) 'docker exec $(CONTAINER) sh -c "grep -l \"$(SIGNATURE)\" $(if $(LOGDIR),$(LOGDIR),/tmp)/asan.* 2>/dev/null | xargs ls -t | head -1 | xargs cat"' > $(OUT)
	@grep -q "$(SIGNATURE)" $(OUT) && echo "extracted to $(OUT)" || (echo "NO report matching $(SIGNATURE) — honest negative, evidence the absence" && exit 1)

# ── Rig lifecycle ───────────────────────────────────────────────────────────

## Rig lifecycle :: rig-asan-up NAME=n IMAGE=i HPORT=h [CPORT=] [NOISE=1] :: start an ASan container :: seccomp=unconfined + detect_leaks=0; abort_on_error=1 default, NOISE=1 switches halt_on_error=0 for known-noise rigs
.PHONY: rig-asan-up
rig-asan-up:
	@test -n "$(NAME)" && test -n "$(IMAGE)" && test -n "$(HPORT)" || (echo "usage: make rig-asan-up NAME=exim-era-asan IMAGE=img:tag HPORT=12686 [CPORT=12625] [NOISE=1]" && exit 2)
	$(VM_SSH) 'docker rm -f $(NAME) 2>/dev/null; docker run -d --name $(NAME) --security-opt seccomp=unconfined -e ASAN_OPTIONS=detect_leaks=0:$(if $(NOISE),halt_on_error=0,abort_on_error=1):log_path=$(if $(LOGDIR),$(LOGDIR),/tmp)/asan -p 127.0.0.1:$(HPORT):$(if $(CPORT),$(CPORT),$(HPORT)) $(IMAGE)'

## Rig lifecycle :: asan-build-gate LOG=path BIN=path :: the two sanitizer build gates :: fsanitize in the build log AND __asan_init in the linked binary (the silent-drop lesson)
.PHONY: asan-build-gate
asan-build-gate:
	@test -n "$(LOG)" && test -n "$(BIN)" || (echo "usage: make asan-build-gate LOG=build.log BIN=/usr/local/exim/bin/exim" && exit 2)
	@if grep -q -- '-fsanitize=address' $(LOG) && nm $(BIN) 2>/dev/null | grep -q __asan_init; then \
		echo "ASAN GATES PASSED"; else \
		echo "ASAN GATE FAILED — a build that silently drops the sanitizer is worse than none"; exit 1; fi

## Rig lifecycle :: rig-restart-recontrol NAME=c SCRIPT=vm-path :: restart a wedged rig, then re-run controls :: the wedge-incident protocol — restart, re-control, only then continue
.PHONY: rig-restart-recontrol
rig-restart-recontrol:
	@test -n "$(NAME)" && test -n "$(SCRIPT)" || (echo "usage: make rig-restart-recontrol NAME=rsync-era SCRIPT=/tmp/vm_controls.sh" && exit 2)
	$(VM_SSH) 'docker restart $(NAME) && sleep 3 && bash $(SCRIPT)'

# ── Unit-of-work gates ──────────────────────────────────────────────────────

## SACD session :: sacd-decode ERRNO=... :: deterministic errno decode (decimal/hex/two's-complement log residue like fffffff3) — never by mental arithmetic (the fffffff3 incident: errno eyeballed in prose mid-debug); name+meaning from the host errno module, the canonical source; bare hex residues (printf %x of a negative int) accepted; selftest: make sacd-decode ERRNO=-- --selftest
.PHONY: sacd-decode
sacd-decode:
	python3 $(SACD)/tools/decode_errno.py $(ERRNO)

## SACD session :: sacd-py SCRIPT=path :: run a local python script with CWD pinned to the repo root :: THE CWD-reset fix for edit scripts — every bash call in this session starts at the session root (the MAIN security repo), and heredoc edits with relative paths kept failing or worse; write the script to /tmp (absolute path), reference repo files by repo-relative paths, and run it through this target so make -C guarantees the working directory
.PHONY: sacd-py
sacd-py:
	@test -n "$(SCRIPT)" || (echo "usage: make sacd-py SCRIPT=/tmp/edit.py (repo-relative paths inside)" && exit 2)
	python3 "$(SCRIPT)"

## SACD session :: sacd-commit MSGFILE=path [PATHS=...] :: commit and push THIS repo through the identity gates :: asserts the git top-level is the canonical SACD checkout AND origin is git@github.com:clintecker/aftermath.git before anything is staged — the a490e51 incident (a sacd sync commit landed in the main security repo from a reset CWD) is structurally impossible when commits only ever happen through this target; refuses on unclean prerequisites loudly
.PHONY: sacd-commit
sacd-commit:
	@test -n "$(MSGFILE)" || (echo "usage: make sacd-commit MSGFILE=/tmp/msg.txt [PATHS=...]" && exit 2)
	@test "$$(git rev-parse --show-toplevel)" = "$$(pwd)" || (echo "FATAL: repo top-level mismatch: $$(git rev-parse --show-toplevel) vs $$(pwd)" && exit 1)
	@test "$$(git remote get-url origin)" = "git@github.com:clintecker/aftermath.git" || (echo "FATAL: origin is $$(git remote get-url origin), not the canonical aftermath remote" && exit 1)
	$(if $(PATHS),git add $(PATHS),git add -A)
	@git status --short | head -20
	git commit -q -F "$(MSGFILE)" && git push -q origin HEAD && echo "canonical pushed: $$(git rev-parse HEAD)"

## SACD session :: sacd-sync-standalone [MSG=...] :: mirror the canonical tree into the standalone review repo (tests there, commit, push) :: the dual-repo discipline as one command — stages tools + gate/hdhost evidence + docs + kit + Makefile/AGENTS into clintecker/sacd-reconstruct, verifies ITS origin remote and top-level, runs the 11 alteration controls in that tree, and commits with the canonical hash; refuses if either repo has the wrong identity or the canonical tree is dirty
.PHONY: sacd-sync-standalone
sacd-sync-standalone:
	bash experiments/sacd_reconstruct/tools/sacd_sync_standalone.sh "$(MSG)"

## SACD vm-tools :: sacd-stage :: (no arguments) :: stage every tracked guest-tool source to the VM in one shot :: the stale-copy killer — the tree is the single source of truth; VM copies are disposable and re-staged before every consuming run (the stale-probe trap bit three times: an old probe/runner silently produced old-format evidence that only the hardened gate caught)
.PHONY: sacd-stage
sacd-stage:
	$(VM_SCP) experiments/sacd_reconstruct/tools/bx510_*.c experiments/sacd_reconstruct/tools/bx510_*.py experiments/sacd_reconstruct/tools/bx510_*.sh experiments/sacd_reconstruct/tools/fixture_gen.py $(VM_USER)@$(VM_HOST):/tmp/ || exit 1
	@echo "staged: tracked bx510_* tools + fixture_gen.py -> VM:/tmp"

## SACD vm-tools :: sacd-kit-stage :: (no arguments) :: stage the tracked emulator-kit sources to the VM :: the QEMU kit on the VM (~/bx510-emu/emulator) is disposable — the tracked emulator-kit/ dir is the live state; build.sh on the VM consumes exactly these files
.PHONY: sacd-kit-stage
sacd-kit-stage:
	$(VM_SCP) experiments/sacd_reconstruct/emulator-kit/sony-bx510.c experiments/sacd_reconstruct/emulator-kit/mt8560-nfi.c experiments/sacd_reconstruct/emulator-kit/mt8560-nfi.h experiments/sacd_reconstruct/emulator-kit/mt8560-hdhost.c experiments/sacd_reconstruct/emulator-kit/mt8560-hdhost.h experiments/sacd_reconstruct/emulator-kit/build.sh experiments/sacd_reconstruct/emulator-kit/qemu-integration.patch experiments/sacd_reconstruct/emulator-kit/run.py experiments/sacd_reconstruct/emulator-kit/smoke.py $(VM_USER)@$(VM_HOST):bx510-emu/emulator/ || exit 1
	@echo "staged: tracked emulator-kit -> VM:~/bx510-emu/emulator/"

## SACD hdhost :: sacd-hdhost-qemu :: (no arguments) :: rebuild QEMU on the VM from the tracked kit state :: build.sh copies the staged kit files into the pinned qemu-9.2.4 tree and ninjas qemu-system-arm — minutes; run after any emulator-kit change
.PHONY: sacd-hdhost-qemu
sacd-hdhost-qemu: sacd-kit-stage
	$(VM_SSH) 'sh ~/bx510-emu/emulator/build.sh 2>&1 | tail -3'

## SACD hdhost :: sacd-hdhost-mod :: (no arguments) :: build the HDHOST guest block-driver module through the proven pipeline :: -U__LINUX_ARM_ARCH__ -D__LINUX_ARM_ARCH__=6 compiles the module NATIVELY armv6 — v6 mcr barriers (dmb/dsb are v6K+/v7 and TCG-rejected), native ARMv6 vermagic (no kpatch), no bdpswap (no exported symbols)
.PHONY: sacd-hdhost-mod
sacd-hdhost-mod: sacd-stage
	$(VM_SSH) 'set -e; mkdir -p /tmp/hdmod; cp /tmp/bx510_hdhost.c /tmp/hdmod/; echo "obj-m := bx510_hdhost.o" > /tmp/hdmod/Makefile; cd ~/sony-kernel/linux-2.6.35; export CROSS_COMPILE=~/gnuarm/bin/arm-none-linux-gnueabi-; make ARCH=arm M=/tmp/hdmod modules EXTRA_CFLAGS="-U__LINUX_ARM_ARCH__ -D__LINUX_ARM_ARCH__=6 -march=armv6 -Wa,-march=armv6" >/tmp/hdbuild.log 2>&1 || { grep -iE "error" /tmp/hdbuild.log | head -8; exit 1; }; ~/gnuarm/bin/arm-none-linux-gnueabi-strings /tmp/hdmod/bx510_hdhost.ko | grep vermagic'

## SACD hdhost :: sacd-hdhost-smoke :: (no arguments) :: HDHOST end-to-end smoke: sentinel image, guest boot with device checks, host-vs-guest md5 verdict :: runs tools/bx510_hdsmoke.sh on the VM — patterned sectors through the guest block node must match host expectations and a past-capacity read must FAIL (EIO, never zero-filled); pulls the smoke log back into evidence/bx510-guest/hdhost/
.PHONY: sacd-hdhost-smoke
sacd-hdhost-smoke: sacd-stage sacd-hdhost-mod
	$(VM_SCP) experiments/sacd_reconstruct/tools/bx510_hdsmoke.sh $(VM_USER)@$(VM_HOST):/tmp/bx510_hdsmoke.sh
	$(VM_SSH) 'sh /tmp/bx510_hdsmoke.sh' | tee /tmp/hdsmoke-local.out | tail -12
	-$(VM_SSH) 'ls -dt /tmp/hdsmoke-* | head -1' | xargs -I{} $(VM_SCP) -r "$(VM_USER)@$(VM_HOST):{}" experiments/sacd_reconstruct/evidence/bx510-guest/hdhost/ 2>/dev/null

## SACD gates :: sacd-gate4 :: (no arguments) :: the 5 GiB boundary-sentinel battery — the team's final large-image validation :: both pinned daemons serve hash-verified sectors straddling the 2 GiB and 4 GiB byte-offset boundaries from a host-backed sparse image through BOTH read paths; clamp at the new track range, final sector, beyond-capacity; byte-identity, raw-frame verification, self-pairs in the verdict; image is regenerable (SHA-recorded manifest kept, binaries dropped)
.PHONY: sacd-gate4
sacd-gate4: sacd-stage
	$(VM_SSH) 'sh /tmp/bx510_gate4.sh' 2>/dev/null || { $(VM_SCP) experiments/sacd_reconstruct/tools/bx510_gate4.sh $(VM_USER)@$(VM_HOST):/tmp/; $(VM_SSH) 'sh /tmp/bx510_gate4.sh'; }
	-OUT=$$($(VM_SSH) 'ls -dt /tmp/gate4v-* 2>/dev/null | head -1'); if [ -n "$$OUT" ]; then mkdir -p experiments/sacd_reconstruct/evidence/bx510-guest/gates4; $(VM_SCP) -r "$(VM_USER)@$(VM_HOST):$$OUT" experiments/sacd_reconstruct/evidence/bx510-guest/gates4/ >/dev/null 2>&1; echo "evidence pulled: gates4/$$(basename $$OUT)"; fi

## SACD gates :: sacd-gate3 :: (no arguments) :: HDHOST intermediate gate: the canonical 6-boot validation with the disc served through the host-image interface :: reuses the existing fixture content and gate expectations UNCHANGED — only the transport differs (tmpfs file -> HDHOST block node), so a PASS proves the whole large-image path with known expectations; per-boot C-vs-PY byte-identity asserted; negative control corrupts the host image variant; pulls evidence into evidence/bx510-guest/gates3/
.PHONY: sacd-gate3
sacd-gate3: sacd-stage
	$(VM_SSH) 'cp /tmp/bx510_gate3.sh /tmp/gate3.sh; sh /tmp/gate3.sh' | tail -30
	-OUT=$$($(VM_SSH) 'ls -dt /tmp/gate3v-* 2>/dev/null | head -1'); if [ -n "$$OUT" ]; then mkdir -p experiments/sacd_reconstruct/evidence/bx510-guest/gates3; $(VM_SCP) -r "$(VM_USER)@$(VM_HOST):$$OUT" experiments/sacd_reconstruct/evidence/bx510-guest/gates3/ >/dev/null 2>&1; echo "evidence pulled: gates3/$$(basename $$OUT)"; fi

## SACD gates :: sacd-gate :: (no arguments) :: the canonical 6-boot gate from tracked sources, end to end :: stages every tracked tool first (kills the stale-copies class), runs tools/bx510_gate2.sh (fresh timestamped dir, probe-failure propagation, raw-frame verification in the verdict), then pulls the evidence dir into evidence/bx510-guest/gates/
.PHONY: sacd-gate
sacd-gate: sacd-stage
	$(VM_SSH) 'cp /tmp/bx510_gate2.sh /tmp/gate2.sh' 2>/dev/null || true
	$(VM_SSH) 'cp /tmp/bx510_gate2.sh /tmp/gate2.sh; sh /tmp/gate2.sh' | tail -8
	-OUT=$$($(VM_SSH) 'ls -dt /tmp/gatev-* 2>/dev/null | head -1'); if [ -n "$$OUT" ]; then $(VM_SCP) -r "$(VM_USER)@$(VM_HOST):$$OUT" experiments/sacd_reconstruct/evidence/bx510-guest/gates/ >/dev/null 2>&1; echo "evidence pulled: experiments/sacd_reconstruct/evidence/bx510-guest/gates/$$(basename $$OUT)"; fi

## Unit-of-work gates :: tests :: the verbatim finished-unit test gate :: uv run pytest -m "not smoke"; un-piped, exit-code-checked
.PHONY: tests
tests:
	uv run pytest -m "not smoke"

## Unit-of-work gates :: commit-unit MSGFILE=path [PATHS=...] :: the full finished-unit gate chain :: docs-check, then tests (exit-checked), then private-remote check, commit -F, push — the pipe-masking incident structurally prevented
.PHONY: commit-unit
commit-unit:
	@test -n "$(MSGFILE)" || (echo "usage: make commit-unit MSGFILE=/tmp/msg.txt [PATHS=findings/...]" && exit 2)
	@echo "-- gate 0: AGENTS.md targets block in sync with the Makefile"
	@$(MAKE) --no-print-directory docs-check
	@echo "-- gate 1: tests (un-piped, exit-code-checked)"
	@uv run pytest -m "not smoke" -q || (echo "TESTS FAILED — no commit" && exit 1)
	@echo "-- gate 2: private remote check"
	@git remote get-url origin | grep -q "clintecker/aftermath" || (echo "REMOTE IS NOT THE PRIVATE ONE — refusing to push" && exit 1)
	@git add $(if $(PATHS),$(PATHS),-A)
	@git commit -F $(MSGFILE)
	@git push origin
	@echo "-- unit committed and pushed"

## Unit-of-work gates :: cvss VECTOR='CVSS:4.0/...' :: score a CVSS 4.0 vector via the cvss library :: mandatory metrics enforced (SC/SI/SA required, no S: scope metric — cost the writer three attempts)
.PHONY: cvss
cvss:
	@test -n "$(VECTOR)" || (echo "usage: make cvss VECTOR='CVSS:4.0/AV:N/AC:L/AT:N/PR:N/UI:N/VC:N/VI:N/VA:H/SC:N/SI:N/SA:N/E:A'" && exit 2)
	uv run --with cvss python -c "from cvss import CVSS4; c=CVSS4('$(VECTOR)'); print('scores:', c.scores(), 'severity:', c.severities()); print('vector:', c.clean_vector())"

# ── Analysis & session ops ──────────────────────────────────────────────────

## Analysis & session ops :: child-triage ID=run-id :: the subagent hang-triage procedure :: log-growth + process checks BEFORE any interrupt — elapsed tool time is a prompt to look, not a verdict (the 1-for-3 lesson)
.PHONY: child-triage
child-triage:
	@test -n "$(ID)" || (echo "usage: make child-triage ID=64f1372e-..." && exit 2)
	@OUT=$$(ls /var/folders/9w/*/T/pi-subagents-uid-501/async-subagent-runs/$(ID)/output-0.log 2>/dev/null | head -1); \
	if [ -z "$$OUT" ]; then echo "no output log found for $(ID) — check the run id"; exit 2; fi; \
	S1=$$(stat -f%z "$$OUT"); sleep 12; S2=$$(stat -f%z "$$OUT"); \
	echo "log growth over 12s: $$S1 -> $$S2 ($$(( S2 - S1 )) bytes)"; \
	if [ "$$S2" -gt "$$S1" ]; then echo "VERDICT: streaming — working, do NOT interrupt"; \
	else echo "VERDICT: static — check CPU time next:"; \
	  ps aux | grep -E "battery|timeout|ruby|docker" | grep -v grep || true; \
	  echo "Low CPU + static = wedged early (interrupt+resume); streaming-then-static = real hang; slow-but-CPU-busy = legitimate long command."; \
	  echo "RULE: interrupt is run-scoped and costs the child its in-flight turn — verify first."; fi

## Analysis & session ops :: hunt-new TARGET=name :: scaffold a new campaign :: wraps tools/harness/new_hunt.py (hunt dir + battery skeleton + results template)
.PHONY: hunt-new
hunt-new:
	@test -n "$(TARGET)" || (echo "usage: make hunt-new TARGET=rsync" && exit 2)
	uv run python tools/harness/new_hunt.py $(TARGET)



## Fire & evidence :: gt-fire [RIG=hunt] [FILTER='...'] [WHICH=asan] OR CONTAINER=c PORT=n :: the GT/probe decisive-fire pipeline :: ordered sequence ENFORCED: ASan baseline -> canary control -> filtered fire -> report pull -> post-fire canary; RIG= reads rig/manifest.json (no retyping); stops at the first failed gate
.PHONY: gt-fire
gt-fire:
	@if [ -n "$(RIG)" ]; then \
	  eval "$$(python3 tools/harness/rig_var.py $(RIG) --env $(if $(WHICH),$(WHICH),asan))"; \
	  CNT=$$CONTAINER; PRT=$$PORT; BAT=$$BATTERY; VMD=$$VM_DIR; LOGD=$$ASAN_LOGDIR; \
	  CMOD=$$CANARY_MODULE; CFILE=$$CANARY_FILE; CMARK=$$CANARY_MARKER; CPROBE=$$CANARY_PROBE; \
	else \
	  CNT="$(RIG)"; PRT="$(PORT)"; BAT="$(BATTERY)"; VMD="$(if $(RIGDIR),$(RIGDIR),/tmp)"; LOGD="$(if $(LOGDIR),$(LOGDIR),/tmp)"; \
	  CMOD="$(HUNT5_MOD)"; CFILE="$(HUNT5_FILE)"; CMARK="$(HUNT5_MARKER)"; CPROBE=d_post_canary; \
	fi; \
	[ -n "$$CNT" ] && [ -n "$$PRT" ] && [ -n "$(FILTER)" ] || { echo "usage: make gt-fire RIG=rsync_hunt FILTER='b_sums'  |  or explicit: CONTAINER=c PORT=n FILTER='...'"; exit 2; }; \
	ENVLINE="HUNT5_HOST=127.0.0.1 HUNT5_PORT=$$PRT HUNT5_MOD=$$CMOD HUNT5_FILE=$$CFILE HUNT5_MARKER=$$CMARK HUNT5_HOLD=15 HUNT5_IDLE=2 HUNT5_PROBE_CAP=60"; \
	echo "-- gate 1: ASan noise baseline on $$CNT"; \
	B=$$($(VM_SSH) "docker exec $$CNT sh -c 'grep -h \"ERROR: AddressSanitizer\" $$LOGD/asan.* 2>/dev/null | wc -l'"); echo "baseline reports: $$B"; \
	echo "-- gate 2: canary control ($$CPROBE)"; \
	$(VM_SSH) "cd $$VMD && $$ENVLINE HUNT5_ONLY=$$CPROBE HUNT5_OUT=/tmp/gt-control.jsonl timeout 120 ruby $$BAT live 2>&1 | tail -1" || { echo "canary control FAILED - suspect the RIG first"; exit 1; }; \
	echo "-- gate 3: FILTERED fire: $(FILTER)"; \
	$(VM_SSH) "cd $$VMD && $$ENVLINE HUNT5_ONLY='$(FILTER)' HUNT5_OUT=/tmp/gt-fire.jsonl timeout 600 ruby $$BAT live 2>&1 | tail -6"; \
	echo "-- gate 4: NEW ASan reports vs baseline"; \
	N=$$($(VM_SSH) "docker exec $$CNT sh -c 'grep -h \"ERROR: AddressSanitizer\" $$LOGD/asan.* 2>/dev/null | wc -l'"); \
	echo "baseline=$$B now=$$N new=$$((N-B))"; \
	if [ $$((N-B)) -gt 0 ]; then \
	  $(VM_SSH) "docker exec $$CNT sh -c 'grep -h \"ERROR: AddressSanitizer\" $$LOGD/asan.* 2>/dev/null | sort | uniq -c'"; \
	else echo "no new ASan reports - honest negative IF the filter matched cells (verify the JSONL matched-cell count is >0!)"; fi; \
	echo "-- gate 5: post-fire canary"; \
	$(VM_SSH) "cd $$VMD && $$ENVLINE HUNT5_ONLY=$$CPROBE HUNT5_OUT=/tmp/gt-postcanary.jsonl timeout 120 ruby $$BAT live 2>&1 | tail -1"; \
	echo "gt-fire complete - evidence on the VM at /tmp/gt-{control,fire,postcanary}.jsonl (pull: make vm-pull-file)"

## VM transport :: source-fetch URL=... [SIGURL=...] DEST=dir [STAGE=1] :: fetch+verify+record an era source tarball ON THE MAC :: network-policy in tooling: public fetches happen Mac-side only; records sha256+URL+date into DEST/PROVENANCE.md; STAGE=1 also scp's it to VM:/tmp/
.PHONY: source-fetch
source-fetch:
	@test -n "$(URL)" && test -n "$(DEST)" || (echo "usage: make source-fetch URL=https://...tar.gz [SIGURL=https://...asc] DEST=findings/minrepro/x/source [STAGE=1]" && exit 2)
	@mkdir -p $(DEST)
	@F=$(DEST)/$$(basename $(URL)); curl -sL --max-time 300 "$(URL)" -o "$$F"
	@if [ -n "$(SIGURL)" ]; then curl -sL --max-time 120 "$(SIGURL)" -o "$(DEST)/$$(basename $(SIGURL))"; fi
	@echo "| $$(date -u +%Y-%m-%dT%H:%MZ) | $(URL) | sha256:$$(shasum -a 256 "$$F" | cut -d" " -f1) | $$(stat -f%z "$$F") bytes | sig: $$(basename $(SIGURL)) |" >> $(DEST)/PROVENANCE.md
	@if [ "$(STAGE)" = "1" ]; then $(MAKE) --no-print-directory vm-stage-file FILE="$$F"; fi
	@echo "fetched + recorded: $$F (PROVENANCE.md updated)"

## Fire & evidence :: evidence-pull FILES='vm-path...' DEST=local-dir :: batch-pull evidence files from the VM :: the standard post-fire ritual: JSONLs, ASan reports, logs - named once, pulled together
.PHONY: evidence-pull
evidence-pull:
	@test -n "$(FILES)" && test -n "$(DEST)" || (echo "usage: make evidence-pull FILES='/tmp/a.jsonl /tmp/asan.392' DEST=findings/.../evidence/" && exit 2)
	@mkdir -p $(DEST)
	@for f in $(FILES); do $(VM_SCP) "$(VM_USER)@$(VM_HOST):$$f" "$(DEST)/" || echo "MISSING (honest gap recorded): $$f"; done
	@echo "pulled into $(DEST)"

# ── SACD reconstruction (sacd_extract_160) ──────────────────────────────────
# Runs on the lab VM via the same keyed-ssh channel as the vm-* family.
# VM tree: ~/sacd-verify (repo-shaped: original/, tools/, incoming/,
# reconstruct -> ~/reconstruct). VM check-python: ~/sacdtest-venv
# (pyelftools + unicorn installed from Mac-staged wheels).

SACD      := experiments/sacd_reconstruct
SACD_ORIG := $(SACD)/original/sacd_extract_160
SACD_CAND ?= $(SACD)/reconstruct/release/sacd_extract_160_release
SACD_VM   := sacd-verify
SACD_PY   := $$HOME/sacdtest-venv/bin/python
SACD_VM_RIG_OUT ?= /tmp/sacd-rig
ELF ?= $(SACD_CAND)

## SACD :: sacd-sync :: stage the sacd-verify tree + build sources to the lab VM :: tar-pipe private channel — repo members go to ~/sacd-verify; reconstruct SOURCES stream directly into the VM build tree ~/reconstruct (never extract a directory member through the ~/sacd-verify/reconstruct symlink — GNU tar replaces the symlink with a real dir and orphans the build tree, which cost the release ELF once); release/ and build/ stay VM-owned
.PHONY: sacd-sync
sacd-sync:
	COPYFILE_DISABLE=1 tar -cf - -C $(SACD) --exclude='reconstruct' tools original incoming docs evidence/bx510/BASELINE-RUNBOOK.md | $(VM_SSH) 'mkdir -p ~/$(SACD_VM) && tar -xf - -C ~/$(SACD_VM)'
	COPYFILE_DISABLE=1 tar -cf - -C $(SACD)/reconstruct --exclude='build' --exclude='release' . | $(VM_SSH) 'mkdir -p ~/reconstruct && tar -xf - -C ~/reconstruct && ln -sfn ~/reconstruct ~/$(SACD_VM)/reconstruct && echo staged'

## SACD :: sacd-verify :: clean-checkout release build + every check, on the VM :: make verify in reconstruct/ — builds from tracked sources, prints candidate SHA-256, runs fn_diff/interface/status/division/pool checks against that exact file; reproducible bit-identical across runs
.PHONY: sacd-verify
sacd-verify:
	$(VM_SSH) 'cd ~/$(SACD_VM)/reconstruct && VERIFY_PY=$(SACD_PY) sh ../tools/release_verify.sh'

## SACD :: sacd-rig [DISC=~/sacd-verify/firebird.iso] [OUT=<stamp>] :: QEMU protocol rig: original vs release candidate over the same disc fixture :: replays DISC_OPEN→SIZE→READ×3→CLOSE→reconnect→repeat against both daemons under sacd_rig.so, compares transcripts (result codes, payload hashes), pulls manifests as evidence — pkill-stale hygiene included because a wedged daemon holds port 2002
.PHONY: sacd-rig
sacd-rig:
	@test -n "$(call if-defined,DISC)" || true
	$(VM_SSH) 'cd ~/$(SACD_VM) && rm -rf $(SACD_VM_RIG_OUT) && sh tools/rig_run.sh original/sacd_extract_160 reconstruct/release/sacd_extract_160_release $(SACD_VM_RIG_OUT) $(if $(DISC),$(DISC),$$HOME/sacd-verify/firebird.iso)'
	@RIGDIR=$(SACD)/evidence/qemu-rig/$$(date -u +%Y%m%d-%H%M%S)
	@for d in capture-orig capture-cand overlap-orig overlap-cand; do mkdir -p $$RIGDIR/$$d; $(VM_SCP) -r "$(VM_USER)@$(VM_HOST):$(SACD_VM_RIG_OUT)/$$d/." $$RIGDIR/$$d/; done
	@for l in daemon-orig.log daemon-cand.log daemon-orig2.log daemon-cand2.log; do $(VM_SCP) "$(VM_USER)@$(VM_HOST):$(SACD_VM_RIG_OUT)/$$l" "$$RIGDIR/" 2>/dev/null || true; done
	@echo "evidence: $$RIGDIR"
	@python3 $(SACD)/tools/sacd_client.py compare $$RIGDIR/capture-orig/manifest.json $$RIGDIR/capture-cand/manifest.json
	@python3 $(SACD)/tools/sacd_client.py compare $$RIGDIR/overlap-orig/manifest.json $$RIGDIR/overlap-cand/manifest.json

## SACD :: sacd-parity [ELF=$(SACD_CAND)] :: Mac-side parity harness against one ELF :: fn_diff (390 normalized functions; only the accepted _start + call_gmon_start residuals may remain) + pool_audit (literal content, load-site positional) + both literal regression tests — the tool chain that caught the L"c" and __FILE__ misreads
.PHONY: sacd-parity
sacd-parity:
	sh $(SACD)/tools/sacd_parity.sh $(SACD_ORIG) $(ELF)

## SACD :: sacd-selftest :: validate the TCP client against an in-process fake server :: stdlib-only check of the wire protocol before any real capture — the same client runs on Mac (BX510 baseline) and Linux (VM rig)
.PHONY: sacd-selftest
sacd-selftest:
	python3 $(SACD)/tools/sacd_client.py selftest --out /tmp/sacd-selftest

# ── SACD full-system emulator (BX510 handoff) ───────────────────────────────
# Third verification leg: boots Sony's Linux 2.6.35 from the synthetic NAND
# inside the sony-bx510 QEMU machine and runs the daemons in the REAL guest
# OS. VM tree: ~/bx510-emu (emulator kit, images/, pre-staged qemu tarball —
# the build script's own download path is bypassed so nothing leaves the VM).

## SACD :: sacd-emu-build :: build the full-system sony-bx510 QEMU on the lab VM :: the pinned 9.2.4 tarball is pre-staged (SHA f3cc1c4e… verified at stage time) so build.sh performs no outbound fetch; JOBS=6
.PHONY: sacd-emu-build
sacd-emu-build:
	$(VM_SSH) 'cd ~/bx510-emu/emulator && mkdir -p work && cp -n ~/bx510-emu/qemu-9.2.4.tar.xz work/qemu-9.2.4.tar.xz && JOBS=6 sh build.sh work'

## SACD :: sacd-emu-smoke :: full-system guest smoke tests :: the emulator team's pinned PASS set — shell (Sony PID 1, kernel 2.6.35, bdpdrv.ko digest), handoff, fastboot, control-ramdisk
.PHONY: sacd-emu-smoke
sacd-emu-smoke:
	$(VM_SSH) 'cd ~/bx510-emu/emulator && python3 smoke.py --qemu work/build/qemu-system-arm --images ../images shell && python3 smoke.py --qemu work/build/qemu-system-arm --images ../images handoff && python3 smoke.py --qemu work/build/qemu-system-arm --images ../images fastboot && python3 ramdisk_control.py --qemu work/build/qemu-system-arm --images ../images'

## SACD :: sacd-emu-daemons :: run both daemon ELFs inside Sony's real guest OS :: the loader/libc compatibility proof — the original and the release candidate must produce identical --help bytes under Sony's shipped libraries with eager binding
.PHONY: sacd-emu-daemons
sacd-emu-daemons:
	$(VM_SSH) 'cd ~/bx510-emu/emulator && python3 verify_daemons.py --qemu work/build/qemu-system-arm --images ../images --reference ~/sacd-verify/original/sacd_extract_160 --release ~/reconstruct/release/sacd_extract_160_release'

